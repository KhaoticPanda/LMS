<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="application.loginController">
    <children>
        <VBox alignment="CENTER" spacing="15" AnchorPane.topAnchor="50" AnchorPane.leftAnchor="50" AnchorPane.rightAnchor="50">
            <children>
                <Label text="Library Management System" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                
                <Label text="Enter your ID:"/>
                <TextField fx:id="studentIdField" promptText="Student or Librarian ID"/>

                <Label text="Enter your Password:"/>
                <PasswordField fx:id="passwordField" promptText="Password"/>

                <HBox alignment="CENTER" spacing="15">
                    <children>
                        <Button text="Student Login" onAction="#handleStudentLogin" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                        <Button text="Librarian Login" onAction="#handleLibrarianLogin" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
        </VBox>
    </children>
</AnchorPane>
