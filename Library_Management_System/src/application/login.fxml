<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="application.loginController"
            prefHeight="400" prefWidth="500">
    <children>
        <VBox alignment="CENTER" spacing="15" layoutX="100" layoutY="50">
            <Label text="Library Management System" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <TextField fx:id="emailField" promptText="Email" prefWidth="300"/>
            <PasswordField fx:id="passwordField" promptText="Password" prefWidth="300"/>

            <HBox alignment="CENTER" spacing="10">
                <Button text="Student Login" onAction="#handleStudentLogin"/>
                <Button text="Librarian Login" onAction="#handleLibrarianLogin"/>
            </HBox>

            <Label fx:id="statusLabel" textFill="red" />
        </VBox>
    </children>
</AnchorPane>
