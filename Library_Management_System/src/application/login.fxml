<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="application.loginController">
    <children>
        <VBox alignment="CENTER" spacing="15" AnchorPane.leftAnchor="50" AnchorPane.rightAnchor="50" AnchorPane.topAnchor="30">
            <children>

                <!-- 🏷️ App title -->
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Library Management System" />

                <Label text="Enter your ID:" />
                <TextField fx:id="studentIdField" promptText="Student or Librarian ID" />

                <Label text="Enter your Password:" />
                <PasswordField fx:id="passwordField" promptText="Password" />

                <HBox alignment="CENTER" spacing="15">
                    <children>
                        <Button onAction="#handleStudentLogin" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Student Login" />
                        <Button onAction="#handleLibrarianLogin" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="Librarian Login" />
                    </children>
                </HBox>

            </children>
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
        </VBox>
    </children>
</AnchorPane>
