<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="application.studentDashboardController"
            prefWidth="1000" prefHeight="700">

    <!-- Top Header -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #2C3E50; -fx-padding: 15;">
            <Label text="📚 Library" style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;"/>
            <Label fx:id="lblWelcome" text="Welcome, Student" style="-fx-text-fill: #00BFFF; -fx-font-weight: bold; -fx-font-size: 22;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Logout" onAction="#handleLogout"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;"/>
        </HBox>
    </top>

    <!-- Sidebar Menu -->
    <left>
        <VBox spacing="15" alignment="TOP_LEFT" style="-fx-background-color: #ECF0F1; -fx-padding: 20; -fx-pref-width: 250;">
            <Label text="Menu" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>

            <Button text="📚 View Available Books" onAction="#handleViewAvailableBooks"
                    style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 200;"/>
            <Button text="➕ Borrow Book" onAction="#handleBorrowBook"
                    style="-fx-background-color: #27AE60; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 200;"/>
            <Button text="↩ Return Book" onAction="#handleReturnBook"
                    style="-fx-background-color: #F39C12; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 200;"/>
            <Button text="📖 View Borrowed Books" onAction="#handleViewBorrowedBooks"
                    style="-fx-background-color: #8E44AD; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 200;"/>
        </VBox>
    </left>

    <!-- Center Area -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 30;">
            <Label text="Welcome to your Library Dashboard!" 
                   style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
            <Label text="Use the menu on the left to navigate through your library options."
                   style="-fx-font-size: 16; -fx-text-fill: #7F8C8D;"/>
            
            <!-- Placeholder for future content -->
            <VBox fx:id="centerContent" spacing="10" alignment="CENTER" 
                  style="-fx-padding: 20; -fx-border-color: #BDC3C7; -fx-border-width: 1; -fx-border-radius: 5;">
                <Label text="Your notifications and borrowed books info will appear here." 
                       style="-fx-text-fill: #7F8C8D;"/>
            </VBox>
        </VBox>
    </center>

</BorderPane>
