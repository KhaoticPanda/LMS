<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" 
            fx:controller="application.studentDashboardController">
    <children>
        <VBox alignment="CENTER" spacing="20" AnchorPane.leftAnchor="50" AnchorPane.rightAnchor="50" AnchorPane.topAnchor="30">
            <children>

                <!-- 🏷️ Welcome Message -->
                <Label fx:id="lblWelcome" text="Welcome, Student!" style="-fx-font-size: 22px; -fx-font-weight: bold;" />

                <!-- Buttons for student modules -->
                <VBox alignment="CENTER" spacing="15">

                    <Button fx:id="btnAvailableBooks" text="View Available Books" 
                            onAction="#handleViewAvailableBooks" 
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px;"/>
                    
                    <Button fx:id="btnBorrowBook" text="Borrow Book" 
                            onAction="#handleBorrowBook" 
                            style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 14px;"/>
                    
                    <Button fx:id="btnReturnBook" text="Return Book" 
                            onAction="#handleReturnBook" 
                            style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-size: 14px;"/>
                    
                    <Button fx:id="btnBorrowedBooks" text="View Borrowed Books" 
                            onAction="#handleViewBorrowedBooks" 
                            style="-fx-background-color: #9C27B0; -fx-text-fill: white; -fx-font-size: 14px;"/>
                    
                    <Button fx:id="btnLogout" text="Logout" 
                            onAction="#handleLogout" 
                            style="-fx-background-color: #F44336; -fx-text-fill: white; -fx-font-size: 14px;"/>
                    
                </VBox>

                <!-- Placeholder for future UI elements -->
                <!-- Example: TableViews for books or borrow records -->

            </children>
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
        </VBox>
    </children>
</AnchorPane>
