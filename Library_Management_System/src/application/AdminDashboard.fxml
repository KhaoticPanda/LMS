<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="application.adminDashBoardController"
            prefWidth="900" prefHeight="600">

    <!-- Header -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #2C3E50; -fx-padding: 10;">
            <Label text="📚  Library " style="-fx-text-fill: white; -fx-font-size: 18;"/>
            <Label text="Admin" style="-fx-text-fill: #00BFFF; -fx-font-weight: bold; -fx-font-size: 18;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Logout" onAction="#handleLogout"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- Sidebar Menu -->
    <left>
        <VBox spacing="12" alignment="TOP_LEFT" style="-fx-background-color: #ECF0F1; -fx-padding: 20; -fx-pref-width: 250;">
            <Label text="Menu" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
            <Button text="➕  Add Student" onAction="#handleAddStudent"
                    style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 200;"/>
            <Button text="✅  Authorize Borrow Requests" onAction="#handleAuthorizeBorrow"
                    style="-fx-background-color: #27AE60; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 200;"/>
            <Button text="📘  Add New Book Copies" onAction="#handleAddBookCopies"
                    style="-fx-background-color: #2980B9; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 200;"/>
            <Button text="↩  Approve Returned Books" onAction="#handleApproveReturned"
                    style="-fx-background-color: #8E44AD; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 200;"/>
            <Button text="💰  Manage Late Fees" onAction="#handleManageLateFees"
                    style="-fx-background-color: #F39C12; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 200;"/>
        </VBox>
    </left>

    <!-- Center Area -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="10" style="-fx-padding: 20;">
            <!-- Welcome Label -->
            <Label fx:id="welcomeLabel" text="Welcome, Librarian!" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>

            <!-- TableView for Approved Returned Books -->
            <TableView fx:id="tblApprovedReturns" prefHeight="400" prefWidth="700">
                <columns>
                    <TableColumn fx:id="colBookTitle" text="Book Title" prefWidth="180"/>
                    <TableColumn fx:id="colStudentName" text="Student Name" prefWidth="180"/>
                    <TableColumn fx:id="colReturnDate" text="Return Date" prefWidth="120"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                    <TableColumn fx:id="colFine" text="Fine" prefWidth="100"/> <!-- NEW COLUMN -->
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
